{
  "name": "FP&A CFO Theme",
  "dataColors": ["#1F3864", "#2E75B6", "#00B0F0", "#107C10", "#D13438", "#F4B942"],
  "background": "#FFFFFF",
  "foreground": "#1F3864",
  "tableAccent": "#2E75B6",
  "textClasses": {
    "title": { "fontFace": "Segoe UI", "fontSize": 14, "fontWeight": "Bold", "color": "#1F3864" },
    "header": { "fontFace": "Segoe UI", "fontSize": 14, "fontWeight": "Bold", "color": "#1F3864" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#1F3864" },
    "callout": { "fontFace": "Segoe UI", "fontSize": 18, "fontWeight": "Bold", "color": "#1F3864" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [{ "fontFamily": "Segoe UI", "fontSize": 14, "fontColor": { "solid": { "color": "#1F3864" } }, "fontWeight": "Bold" }],
        "labels": [{ "fontFamily": "Segoe UI", "fontSize": 10, "color": { "solid": { "color": "#1F3864" } } }],
        "categoryAxis": [{ "gridlineColor": { "solid": { "color": "#D9D9D9" } }, "fontFamily": "Segoe UI", "fontSize": 10 }],
        "valueAxis": [{ "gridlineColor": { "solid": { "color": "#D9D9D9" } }, "fontFamily": "Segoe UI", "fontSize": 10 }],
        "background": [{ "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }]
      }
    },
    "card": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#1F3864" } }, "transparency": 0 }],
        "labels": [{ "color": { "solid": { "color": "#FFFFFF" } }, "fontFamily": "Segoe UI", "fontSize": 10 }],
        "calloutValue": [{ "color": { "solid": { "color": "#FFFFFF" } }, "fontFamily": "Segoe UI", "fontSize": 18 }],
        "categoryLabels": [{ "color": { "solid": { "color": "#FFFFFF" } }, "fontFamily": "Segoe UI", "fontSize": 10 }]
      }
    },
    "matrix": {
      "*": {
        "grid": [{ "gridVertical": false, "rowPadding": 6, "outlineColor": { "solid": { "color": "#D9D9D9" } } }],
        "rowHeaders": [{ "fontFamily": "Segoe UI", "fontSize": 10, "backColor": { "solid": { "color": "#F2F2F2" } } }],
        "columnHeaders": [{ "fontFamily": "Segoe UI", "fontSize": 10, "fontColor": { "solid": { "color": "#FFFFFF" } }, "backColor": { "solid": { "color": "#1F3864" } } }],
        "values": [{ "fontFamily": "Segoe UI", "fontSize": 10, "backColorPrimary": { "solid": { "color": "#FFFFFF" } }, "backColorSecondary": { "solid": { "color": "#F2F2F2" } } }]
      }
    },
    "waterfallChart": {
      "*": {
        "sentimentColors": [{ "increaseFill": { "solid": { "color": "#107C10" } }, "decreaseFill": { "solid": { "color": "#D13438" } }, "totalFill": { "solid": { "color": "#1F3864" } }, "otherFill": { "solid": { "color": "#F4B942" } } }]
      }
    }
  }
}
