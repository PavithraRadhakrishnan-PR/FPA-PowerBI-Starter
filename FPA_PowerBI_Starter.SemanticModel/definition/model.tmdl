model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["RepoRoot", "DimDate", "DimAccount", "DimProduct", "DimRegion", "DimDepartment", "DimScenario", "FactFinancials", "FactHeadcount", "Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table DimDate
ref table DimAccount
ref table DimProduct
ref table DimRegion
ref table DimDepartment
ref table DimScenario
ref table FactFinancials
ref table FactHeadcount
ref table Measures
