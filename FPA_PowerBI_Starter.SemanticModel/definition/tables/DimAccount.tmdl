	partition DimAccount = m
		mode: import
		source =
				let
				    CsvPath = if Text.EndsWith(RepoRoot, "/") or Text.EndsWith(RepoRoot, "\\") then RepoRoot & "data/DimAccount.csv" else RepoRoot & "/data/DimAccount.csv",
