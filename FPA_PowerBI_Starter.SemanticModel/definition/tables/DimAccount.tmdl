				    ChangedType = Table.TransformColumnTypes(PromotedHeaders,{{"AccountKey", Int64.Type}, {"AccountCode", type text}, {"AccountName", type text}, {"AccountCategory", type text}, {"PLOrder", Int64.Type}, {"IsRevenueDriver", Int64.Type}, {"Sign", Int64.Type}})
				in
				    ChangedType

