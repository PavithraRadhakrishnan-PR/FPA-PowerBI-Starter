		formatString: \$#,0.0;\-$#,0.0;\$#,0.0
		lineageTag: b9d6f876-ac3f-50a5-8e86-f906a79a1e05

	measure 'Budget Opex' =
			-CALCULATE([Total Amount], DimScenario[IsBudget] = 1, DimAccount[AccountCategory] = "Opex", DimAccount[AccountName] <> "Depreciation & Amortization")
		formatString: \$#,0.0;\-$#,0.0;\$#,0.0
		lineageTag: 117ab294-f358-546f-a2bc-47021133f458

	measure 'Forecast Opex' =
			-CALCULATE([Total Amount], DimScenario[IsForecast] = 1, DimAccount[AccountCategory] = "Opex", DimAccount[AccountName] <> "Depreciation & Amortization")
		formatString: \$#,0.0;\-$#,0.0;\$#,0.0
		lineageTag: 4078cdd8-861d-5939-a35c-794c2d6a623d

	measure DA =
			-CALCULATE([Total Amount], DimScenario[IsActual] = 1, DimAccount[AccountName] = "Depreciation & Amortization")
		formatString: \$#,0.0;\-$#,0.0;\$#,0.0
		lineageTag: 84711b30-bdd6-5e35-81d6-c3ca19bd88f7

	measure 'Budget DA' =
			-CALCULATE([Total Amount], DimScenario[IsBudget] = 1, DimAccount[AccountName] = "Depreciation & Amortization")
		formatString: \$#,0.0;\-$#,0.0;\$#,0.0
		lineageTag: bd58fca4-d5f7-525a-86d4-9923fd7968dd

	measure 'Forecast DA' =
			-CALCULATE([Total Amount], DimScenario[IsForecast] = 1, DimAccount[AccountName] = "Depreciation & Amortization")
		formatString: \$#,0.0;\-$#,0.0;\$#,0.0
		lineageTag: 2036379a-8c59-516f-a04c-f9f8ccd84171

	measure EBITDA =
			[Gross Profit] - [Actual Opex]
		formatString: \$#,0.0;\-$#,0.0;\$#,0.0
		lineageTag: 88dda5c0-bc2e-54ad-ac66-fd718b8f9b20

	measure 'Budget EBITDA' =
			[Budget Gross Profit] - [Budget Opex]
