		lineageTag: 0ca91404-a475-5c82-bb2c-2f2c7e39a8b5

	measure 'Variance $ (Favorable)' =
			VAR AccountSign = SELECTEDVALUE(DimAccount[Sign], 1)
			RETURN [Variance $] * AccountSign
		formatString: \$#,0.0;\-$#,0.0;\$#,0.0
		lineageTag: acc71491-16b2-5571-952c-7cf721dd8758

	measure 'Variance % (Favorable)' =
			DIVIDE([Variance $ (Favorable)], ABS([Budget P&L Amount]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b99e611a-8a14-57bc-ba07-8a48185e3011

	measure 'Is Favorable' =
			IF([Variance $ (Favorable)] >= 0, "Favorable", "Unfavorable")
		lineageTag: 662cb1e4-b133-5c07-afa2-46cb45edf27d

	measure 'Favorable Color' =
