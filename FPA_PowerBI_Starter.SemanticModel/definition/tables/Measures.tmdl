		formatString: \$#,0.0;\-$#,0.0;\$#,0.0
		lineageTag: 0143bb68-fa8f-511f-aff4-143f379be71b

	measure 'EBITDA Margin %' =
			DIVIDE([EBITDA], [Actual Revenue])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 4fa6bcb9-df25-5c13-bf42-d6f146b6e94e

	measure 'Budget EBITDA Margin %' =
