table Measures
	lineageTag: acece6d4-93ba-5b7b-b81d-a4c283257490

	measure 'Total Amount' =
			SUM(FactFinancials[Amount])
		formatString: \$#,0.0;\-$#,0.0;\$#,0.0
		lineageTag: a38b7c8f-aa65-58a6-9761-71d9fa275616

	measure 'Signed P&L Amount' =
			SUMX(
			    FactFinancials,
			    FactFinancials[Amount] * RELATED(DimAccount[Sign])
			)
		formatString: \$#,0.0;\-$#,0.0;\$#,0.0
		lineageTag: 0b9df50a-e388-582d-bbf6-91dbde0e4145

	measure 'Total Personnel Cost' =
			SUM(FactHeadcount[PersonnelCost])
		formatString: \$#,0.0;\-$#,0.0;\$#,0.0
		lineageTag: 2ce9c366-45f1-56cd-86ce-ab0085ba4ec7

	measure 'Latest Headcount' =
			VAR LatestDateWithHeadcount =
			    MAXX(
			        FILTER(
			            ALLSELECTED(DimDate[Date]),
			            NOT ISBLANK(CALCULATE(SUM(FactHeadcount[Headcount])))
			        ),
			        DimDate[Date]
			    )
			RETURN
			    CALCULATE(
			        SUM(FactHeadcount[Headcount]),
			        DimDate[Date] = LatestDateWithHeadcount
			    )
		formatString: #,0
		lineageTag: 2ac8793b-fcc6-52ad-b237-ce95bd09c8cb

	measure 'Actual Revenue' =
			CALCULATE([Total Amount], DimScenario[IsActual] = 1, DimAccount[AccountCategory] = "Revenue")
		formatString: \$#,0.0;\-$#,0.0;\$#,0.0
		lineageTag: 8010a3d7-893e-5fd4-8a16-b0b48ae29162

	measure 'Budget Revenue' =
			CALCULATE([Total Amount], DimScenario[IsBudget] = 1, DimAccount[AccountCategory] = "Revenue")
		formatString: \$#,0.0;\-$#,0.0;\$#,0.0
		lineageTag: 14bfc1f2-d697-5317-a460-4d2a89226df5

	measure 'Forecast Revenue' =
			CALCULATE([Total Amount], DimScenario[IsForecast] = 1, DimAccount[AccountCategory] = "Revenue")
		formatString: \$#,0.0;\-$#,0.0;\$#,0.0
		lineageTag: 5a7d45fe-772d-5264-8b0d-f708c8153d73

	measure 'Revenue Variance $' =
			[Actual Revenue] - [Budget Revenue]
		formatString: \$#,0.0;\-$#,0.0;\$#,0.0
		lineageTag: da50abb7-a300-53f1-bd76-221304aa6ee8

	measure 'Revenue Variance %' =
			DIVIDE([Revenue Variance $], ABS([Budget Revenue]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 728a5f97-b057-5d0f-a432-af6299d3210e

	measure 'Revenue Growth YoY $' =
			[Actual Revenue] - [PY Actual Revenue]
		formatString: \$#,0.0;\-$#,0.0;\$#,0.0
		lineageTag: 8e7c88ee-8ce1-5451-ae01-7beebc79f3f9

	measure 'Revenue Growth YoY %' =
			DIVIDE([Revenue Growth YoY $], ABS([PY Actual Revenue]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ed64de87-9bd7-5604-a658-7d2b3814da26

	measure 'Actual COGS' =
			-CALCULATE([Total Amount], DimScenario[IsActual] = 1, DimAccount[AccountCategory] = "COGS")
		formatString: \$#,0.0;\-$#,0.0;\$#,0.0
		lineageTag: 85f8eb18-d47d-5fda-8752-810cb4b42c67

	measure 'Budget COGS' =
			-CALCULATE([Total Amount], DimScenario[IsBudget] = 1, DimAccount[AccountCategory] = "COGS")
		formatString: \$#,0.0;\-$#,0.0;\$#,0.0
		lineageTag: 33f1f0c9-dc18-5de5-8f38-afce166eb0ec

	measure 'Forecast COGS' =
			-CALCULATE([Total Amount], DimScenario[IsForecast] = 1, DimAccount[AccountCategory] = "COGS")
		formatString: \$#,0.0;\-$#,0.0;\$#,0.0
		lineageTag: f7b21bf2-7d86-5113-b4cb-eeffed7a02b8

	measure 'Gross Profit' =
			[Actual Revenue] - [Actual COGS]
		formatString: \$#,0.0;\-$#,0.0;\$#,0.0
		lineageTag: cd1050e5-b730-598c-bf1e-fd563de66560

	measure 'Budget Gross Profit' =
			[Budget Revenue] - [Budget COGS]
		formatString: \$#,0.0;\-$#,0.0;\$#,0.0
		lineageTag: 474be615-d676-5214-b192-9e6d2c5c0075

	measure 'Forecast Gross Profit' =
			[Forecast Revenue] - [Forecast COGS]
		formatString: \$#,0.0;\-$#,0.0;\$#,0.0
		lineageTag: d45af4f4-2677-52a9-ac3f-82003904b162

	measure 'Gross Margin %' =
			DIVIDE([Gross Profit], [Actual Revenue])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 76b01a55-93da-5df9-9071-d010dc88d548

	measure 'Budget Gross Margin %' =
			DIVIDE([Budget Gross Profit], [Budget Revenue])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: cb2b3faf-512a-5fa7-93e6-d531e90ee51f

	measure 'Forecast Gross Margin %' =
			DIVIDE([Forecast Gross Profit], [Forecast Revenue])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 1dac3652-bf8e-57c3-9acb-69b2a25690c6

	measure 'Actual Opex' =
