		formatString: \$#,0.0;\-$#,0.0;\$#,0.0
		lineageTag: 1ceb574c-e9e9-506a-ad41-8be588d4e9de

	measure 'Variance $' =
			[Actual P&L Amount] - [Budget P&L Amount]
